{
  "name": "dormitory-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Dormitory Management System with AI Integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node-dev prisma/seed.ts",
    "test:e2e": "ts-node-dev src/scripts/run-e2e-tests.ts",
    "test:security": "ts-node-dev src/scripts/run-security-audit-tests.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "mysql",
    "gemini-ai",
    "dormitory-management"
  ],
  "author": "Pham Thi Ngoc Anh",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
