generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RoomType {
  STANDARD
  VIP
}

enum RoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
}

enum BedStatus {
  VACANT
  OCCUPIED
  RESERVED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

enum TargetRole {
  ALL
  STUDENT
  ADMIN
}

enum NotificationCategory {
  GENERAL
  URGENT
  REGULATION
  FINANCE
  MAINTENANCE
  EVENT
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  password              String
  fullName              String
  studentCode           String?                @unique
  phone                 String?
  gender                Gender                 @default(MALE)
  role                  Role                   @default(STUDENT)
  avatar                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  occupiedBed           Bed?                   @relation("BedOccupant")
  registrations         Registration[]
  maintenanceRequests   MaintenanceRequest[]
  chatLogs              ChatLog[]
  allocationHistories   BedAllocationHistory[]
  authoredNotifications Notification[]         @relation("NotificationAuthor")
  notificationReads     NotificationRead[]

  @@map("users")
}

model Room {
  id                  Int                  @id @default(autoincrement())
  roomNumber          String               @unique
  building            String
  floor               Int
  roomType            RoomType             @default(STANDARD)
  pricePerMonth       Decimal              @db.Decimal(10, 2)
  capacity            Int                  @default(4)
  currentOccupancy    Int                  @default(0)
  status              RoomStatus           @default(AVAILABLE)
  description         String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  beds                Bed[]
  registrations       Registration[]
  maintenanceRequests MaintenanceRequest[]

  @@map("rooms")
}

model Bed {
  id           Int          @id @default(autoincrement())
  bedNumber    String
  roomId       Int
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  occupiedById Int?         @unique
  occupiedBy   User?        @relation("BedOccupant", fields: [occupiedById], references: [id], onDelete: SetNull)
  status       BedStatus    @default(VACANT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  registrations Registration[]

  @@unique([roomId, bedNumber])
  @@map("beds")
}

model Registration {
  id              Int                @id @default(autoincrement())
  userId          Int
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredRoomId Int?
  preferredRoom   Room?              @relation(fields: [preferredRoomId], references: [id], onDelete: SetNull)
  allocatedBedId  Int?
  allocatedBed    Bed?               @relation(fields: [allocatedBedId], references: [id], onDelete: SetNull)
  semester        String
  academicYear    String
  startDate       DateTime
  endDate         DateTime
  status          RegistrationStatus @default(PENDING)
  note            String?            @db.Text
  rejectionReason String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("registrations")
}

model MaintenanceRequest {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId        Int
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title         String
  description   String            @db.Text
  urgency       UrgencyLevel      @default(MEDIUM)
  status        MaintenanceStatus @default(PENDING)
  adminFeedback String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("maintenance_requests")
}

model Notification {
  id             Int                  @id @default(autoincrement())
  title          String               @db.VarChar(255)
  content        String               @db.Text
  summary        String?              @db.VarChar(500)
  category       NotificationCategory @default(GENERAL)
  priority       NotificationPriority @default(NORMAL)
  targetRole     TargetRole           @default(ALL)
  targetBuilding String?              @db.VarChar(100)
  isPinned       Boolean              @default(false)
  status         NotificationStatus   @default(PUBLISHED)
  viewCount      Int                  @default(0)
  authorId       Int?
  author         User?                @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reads          NotificationRead[]

  @@index([targetRole])
  @@index([status])
  @@index([category])
  @@index([isPinned])
  @@map("notifications")
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model ChatLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String?
  userMessage String   @db.Text
  botReply    String   @db.Text
  createdAt   DateTime @default(now())

  @@map("chat_logs")
}

enum AllocationActionType {
  CHECK_IN
  TRANSFER
  CHECK_OUT
}

model BedAllocationHistory {
  id          Int                  @id @default(autoincrement())
  userId      Int
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBedInfo String?
  toBedInfo   String?
  actionType  AllocationActionType @default(CHECK_IN)
  performedBy String?
  note        String?              @db.Text
  createdAt   DateTime             @default(now())

  @@map("bed_allocation_history")
}

